{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helm",
  "version": "0.4.0",
  "identifier": "dev.helmterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helm",
        "width": 1240,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0c0d0f",
        "dragDropEnabled": true,
        "transparent": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Helm contributors",
    "category": "DeveloperTool",
    "shortDescription": "A terminal made for Claude Code",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyRDcyRDBFNkU2MjdCRDQKUldUVWUySnVEaTNYQWpWTVZtNTkrODlWV25vanBOaG1ZYklOVWZSMEZHZlhXNzQyenN6MUN2NFoK",
      "endpoints": [
        "https://github.com/sovanken/helm-term/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
